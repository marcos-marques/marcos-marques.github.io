---
import { experience } from "../data/experience";
---

<section id="experience" class="py-16">
  <h2 class="text-2xl font-bold mb-8">Experiência</h2>
  <ol class="relative border-l-2 border-slate-200 space-y-8 pl-6">
    {experience.map((job) => (
      <li class="relative">
        <span class="absolute -left-[1.65rem] top-1 w-3 h-3 rounded-full bg-primary border-2 border-white"></span>
        <p class="text-xs font-medium text-slate-600 uppercase tracking-wide">
          {job.start} — {job.end ?? "Presente"}
        </p>
        <h3 class="mt-1 font-semibold text-slate-800">{job.title}</h3>
        <p class="text-slate-500">{job.company}</p>
      </li>
    ))}
  </ol>
</section>
