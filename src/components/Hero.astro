<section id="hero" class="py-20 flex flex-col items-center text-center gap-6">
  <img
    src="/images/avatar.svg"
    alt="Avatar de Marcos Marques"
    width="120"
    height="120"
    class="rounded-full border-4 border-slate-200"
  />
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Marcos Marques</h1>
    <p class="mt-2 text-xl text-slate-500">Engenheiro de Software Sênior</p>
  </div>
  <p class="max-w-xl text-slate-600 leading-relaxed">
