---
---

<section id="contact" class="py-16">
  <h2 class="text-2xl font-bold mb-4">Contato</h2>
  <p class="text-slate-500 mb-6 max-w-md">
    Aberto a oportunidades e colaborações. Fique à vontade para entrar em contato.
  </p>
  <div class="flex flex-col sm:flex-row gap-4">
    <a
      href="https://www.linkedin.com/in/exemplo"
      class="inline-flex items-center gap-2 px-5 py-2 rounded-lg border border-slate-300 font-medium hover:bg-slate-50 transition-colors"
      rel="noopener noreferrer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
           width="18" height="18" aria-hidden="true">
        <path d="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5
                 3H19M18.5 18.5V13.2A3.26 3.26 0 0 0 15.24 9.94C14.39 9.94 13.4 10.46 12.92
                 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31
                 12.17A1.4 1.4 0 0 1 15.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 0 0 8.56
                 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 0 0 5.19 6.88C5.19 7.81 5.95
                 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z"/>
      </svg>
      LinkedIn
    </a>

    <button
      id="reveal-email"
      type="button"
      aria-label="Mostrar e-mail"
      class="inline-flex items-center gap-2 px-5 py-2 rounded-lg border border-slate-300 font-medium hover:bg-slate-50 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round" width="18" height="18" aria-hidden="true">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <span id="email-label">Mostrar e-mail</span>
    </button>
  </div>
</section>

<script>
  const btn = document.getElementById("reveal-email") as HTMLButtonElement;
  const label = document.getElementById("email-label") as HTMLSpanElement;
  let revealed = false;

  btn.addEventListener("click", () => {
    if (!revealed) {
      const parts = ["contato", "@", "example", ".com"];
      const address = parts.join("");
      label.textContent = address;
      btn.setAttribute("aria-label", `E-mail: ${address}`);
      btn.setAttribute("href", `mailto:${address}`);
      revealed = true;
    }
  });
</script>
