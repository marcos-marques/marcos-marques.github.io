---
import { footer } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 py-10 flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col gap-1">
      <p class="font-semibold tracking-tight text-slate-800">{footer.owner}</p>
      <p class="text-sm text-slate-600">{footer.tagline}</p>
    </div>

    <nav aria-label="Links do rodapé">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-700">
        {footer.links.map((l) => (
          <li>
            <a href={l.href} class="hover:text-primary underline-offset-4 hover:underline transition-colors">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 py-5 flex flex-col gap-3 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © <span data-testid="footer-year">{year}</span> {footer.owner}.{" "}
        {footer.builtWithLabel}{" "}
        {footer.builtWith.map((l, i) => (
          <>
            {i > 0 && (i === footer.builtWith.length - 1 ? ` ${footer.builtWithConjunction} ` : ", ")}
            <a href={l.href} class="underline underline-offset-4 hover:text-primary transition-colors">{l.label}</a>
          </>
        ))}.
      </p>
      <a
        href={footer.backToTop.href}
        class="font-medium text-slate-700 hover:text-primary transition-colors"
      >
        <span aria-hidden="true">↑</span> {footer.backToTop.label}
      </a>
    </div>
  </div>
</footer>
